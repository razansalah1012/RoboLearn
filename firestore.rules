rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    // --- COLLECTION RULES ---

    // 1. USERS - Allow anyone signed in to see and create their own profile
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // 2. COURSES - Temporarily allowed for all logged-in users to break the block
    match /courses/{courseId} {
      allow read, write: if isSignedIn();
    }

    // 3. MODULES - Temporarily allowed for all logged-in users
    match /modules/{moduleId} {
      allow read, write: if isSignedIn();
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}